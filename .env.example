# This example is for 8GB+ RAM systems running the Minecraft server.
# --- Infrastructure & Container ---
MC_CONTAINER_NAME=mc-server
MC_SERVER_PORT=25565
MC_MAX_MEMORY=4G

# --- Java & JVM Settings ---
MC_MEMORY=2G
# Performance flags (Generational ZGC for Java 21+ ARM64)
MC_JVM_OPTS=-XX:+UseZGC -XX:+ZGenerational -XX:+UnlockExperimentalVMOptions -XX:+AlwaysPreTouch -XX:+DisableExplicitGC

# --- Minecraft Server Version ---
MC_VERSION=latest
MC_TYPE=VANILLA
MC_ONLINE_MODE=true

# --- Mod Loader Settings (Optional) ---
# Uncomment and configure for NeoForge/Fabric
# MC_TYPE=NEOFORGE
# MC_MOD_TYPE=NEOFORGE
# MC_NEOFORGE_VERSION=21.1.216

# --- RCON Management ---
MC_RCON_PASSWORD=changeme

# --- Auto-Pause Settings ---
MC_AUTOPAUSE_TIMEOUT_EST=600
MC_AUTOPAUSE_TIMEOUT_KN=120

# --- Game Settings (World & Rules) ---
MC_DIFFICULTY=HARD
MC_VIEW_DISTANCE=10
MC_SIMULATION_DISTANCE=8
MC_SPAWN_PROTECTION=0
MC_ALLOW_FLIGHT=true
MC_PLAYER_IDLE_TIMEOUT=0
MC_GAMERULE_PLAYERS_SLEEPING_PERCENTAGE=1
MC_GAMERULE_DO_FIRE_TICK=false

# --- Advanced & Performance ---
MC_MAX_TICK_TIME=60000
MC_SYNC_CHUNK_WRITES=false
